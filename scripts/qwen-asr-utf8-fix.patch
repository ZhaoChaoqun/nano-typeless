+/// Check if the engine is using INT8 quantized decoder.
+/// @return 1 if INT8, 0 if BF16, -1 if engine is null.
+#[no_mangle]
+pub unsafe extern "C" fn qwen_asr_is_int8(engine: *const QwenAsrEngine) -> i32 {
+    if engine.is_null() {
+        return -1;
+    }
+    if (*engine).ctx.is_int8() { 1 } else { 0 }
+}
