+/// Get currently decoded but not-yet-stable (speculative) text.
+/// Returns a heap-allocated C string. Caller must free with `qwen_asr_free_string`.
+#[no_mangle]
+pub unsafe extern "C" fn qwen_asr_stream_get_unfixed(
+    stream: *mut QwenAsrStreamState,
+) -> *mut c_char {
+    if stream.is_null() {
+        return std::ptr::null_mut();
+    }
+    let s = &*stream;
+    let text = match s.state.tokenizer() {
+        Some(tok) => s.state.unfixed_text(tok),
+        None => return std::ptr::null_mut(),
+    };
+    if text.is_empty() {
+        return std::ptr::null_mut();
+    }
+    match CString::new(text) {
+        Ok(cs) => cs.into_raw(),
+        Err(_) => std::ptr::null_mut(),
+    }
+}
